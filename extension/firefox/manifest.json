{
  "manifest_version": 3,
  "name": "Moncevia — Currency & Crypto Companion",
  "short_name": "Moncevia",
  "version": "0.1.2",
  "description": "Conversor informativo de divisas y criptomonedas. Autoriza cada sitio antes de convertir precios.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://data-api.binance.vision/*",
    "https://api.binance.com/*",
    "https://open.er-api.com/*",
    "https://api.coingecko.com/*",
    "https://api.coinbase.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "bridge.js",
        "engine.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Moncevia",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "moncevia-extension@qiaminz.github.io",
      "strict_min_version": "128.0"
    }
  }
}
